node_modules/
# Every .env form is ignored: the bare file AND every variant (.env.local, .env.bak, ...).
# `.env.*` alone does NOT match a bare `.env` — both lines are required, and .env.example is negated back in.
.env
.env.*
!.env.example
*.tgz
# Per-session scratch workspaces + any injected context (carries a token) are never committed.
.sessions/
gardener-context.json
context/
# The full care-engine.md is synced in by deploy/setup, never committed here.
reference/
# A local interactive-session permission grant must never land beside the tracked .claude/agents guides.
.claude/settings.local.json
# .env.example points at the live local DB; a quick mysqldump while debugging is the obvious artifact.
*.sql
*.dump
# Editor swap/backup files, and Node fatal-error reports (mysql2/execa can write these to cwd).
*.swp
*.swo
*~
report.*.json
