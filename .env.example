# --- Read tools talk to the shared MariaDB directly, owner-anchored ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=myplants
DB_PASSWORD=123
DB_NAME=myplants

# --- Runtime-injected by the platform; NOT set by hand in normal runs ---
# GARDENER_SESSION_WORKSPACE = absolute path to this session's scratch dir, which holds
#   gardener-context.json (the OWNER pin + scoped API token). Every tool resolves the workspace
#   from this var only — never from cwd or an argument.
# GARDENER_SESSION_WORKSPACE=/abs/path/to/session-workspace
